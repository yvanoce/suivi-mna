<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#1D9E75">
<title>Suivi Cuisine — MNA</title>
<link rel="manifest" href="#" id="manifest-link">
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=DM+Mono:wght@400;500&display=swap');

:root {
  --green:   #1D9E75; --green-l: #E1F5EE; --green-d: #085041;
  --amber:   #BA7517; --amber-l: #FAEEDA; --amber-d: #633806;
  --blue:    #185FA5; --blue-l:  #E6F1FB; --blue-d:  #0C447C;
  --purple:  #534AB7; --purple-l:#EEEDFE; --purple-d:#3C3489;
  --coral:   #D85A30; --coral-l: #FAECE7; --coral-d: #712B13;
  --pink:    #C2185B; --pink-l:  #FCE4EC; --pink-d:  #880E4F;
  --gray-l:  #F5F3EE; --gray-m:  #E2DED6; --gray:    #6B6863;
  --border:  #E2DED6; --text:    #1E1D1B; --text2:   #6B6863;
  --bg:      #FAFAF8; --bg2:     #F5F3EE; --white:   #FFFFFF;
  --radius:  10px; --radius-sm: 6px;
  --shadow:  0 1px 3px rgba(0,0,0,.06), 0 4px 12px rgba(0,0,0,.04);
  --font: 'DM Sans', sans-serif; --mono: 'DM Mono', monospace;
}

*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden}
body{font-family:var(--font);font-size:13px;color:var(--text);background:var(--bg);display:flex;flex-direction:column}

/* ── TOPBAR ── */
.topbar{height:52px;background:var(--white);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 16px;gap:12px;flex-shrink:0;z-index:10}
.topbar-logo{width:28px;height:28px;background:var(--green);border-radius:8px;display:flex;align-items:center;justify-content:center;color:white;font-size:16px;flex-shrink:0}
.topbar-title{font-size:14px;font-weight:600;color:var(--text);flex:1}
.topbar-sub{font-size:11px;color:var(--text2)}
.topbar-actions{display:flex;gap:8px}

/* ── LAYOUT ── */
.layout{display:flex;flex:1;overflow:hidden}
.sidebar{width:230px;background:var(--white);border-right:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0}
.sidebar-top{padding:12px;border-bottom:1px solid var(--border)}
.sidebar-list{flex:1;overflow-y:auto;padding:8px}
.main{flex:1;overflow-y:auto;padding:16px}

/* ── SEARCH ── */
.search-wrap{position:relative}
.search-wrap input{width:100%;padding:7px 10px 7px 30px;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--bg2);font-family:var(--font);font-size:12px;color:var(--text);outline:none}
.search-wrap input:focus{border-color:var(--green);background:var(--white)}
.search-icon{position:absolute;left:9px;top:50%;transform:translateY(-50%);font-size:13px;color:var(--text2);pointer-events:none}

/* ── JEUNE ITEMS ── */
.jeune-item{display:flex;align-items:center;gap:9px;padding:8px 10px;border-radius:var(--radius-sm);cursor:pointer;transition:background .12s;margin-bottom:2px}
.jeune-item:hover{background:var(--bg2)}
.jeune-item.active{background:var(--green-l)}
.avatar{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;flex-shrink:0;letter-spacing:-.02em}
.jeune-name{font-size:12px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1}
.jeune-meta{font-size:10px;color:var(--text2);margin-top:1px}

/* ── BUTTONS ── */
btn,button{font-family:var(--font);cursor:pointer;border-radius:var(--radius-sm);font-size:12px;padding:6px 14px;border:1px solid var(--border);background:var(--white);color:var(--text);transition:all .12s;outline:none}
button:hover{background:var(--bg2)}
.btn-green{background:var(--green);color:white;border-color:var(--green);font-weight:500}
.btn-green:hover{background:var(--green-d);border-color:var(--green-d)}
.btn-blue{background:var(--blue-l);color:var(--blue-d);border-color:var(--blue)}
.btn-blue:hover{background:#d0e8f8}
.btn-danger{color:var(--coral-d);border-color:var(--coral)}
.btn-danger:hover{background:var(--coral-l)}
.btn-sm{padding:4px 10px;font-size:11px}

/* ── CARDS ── */
.card{background:var(--white);border:1px solid var(--border);border-radius:var(--radius);padding:14px 16px;margin-bottom:10px;box-shadow:var(--shadow)}
.card-title{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--text2);margin-bottom:10px;display:flex;align-items:center;gap:7px}

/* ── INPUTS ── */
input[type=text],input[type=date],input[type=search],textarea,select{
  font-family:var(--font);color:var(--text);background:var(--bg2);
  border:1px solid var(--border);border-radius:var(--radius-sm);
  padding:7px 10px;font-size:12px;outline:none;width:100%;transition:border .12s,background .12s}
input:focus,textarea:focus,select:focus{border-color:var(--green);background:var(--white)}
textarea{resize:vertical;line-height:1.6;min-height:72px}

/* ── TABS ── */
.tabs{display:flex;border-bottom:1px solid var(--border);margin-bottom:14px;gap:0;overflow-x:auto}
.tab{padding:8px 14px;font-size:12px;cursor:pointer;border-bottom:2px solid transparent;color:var(--text2);white-space:nowrap;transition:all .12s;font-family:var(--font)}
.tab:hover{color:var(--text)}
.tab.active{color:var(--green-d);border-bottom-color:var(--green);font-weight:500}

/* ── STATS ── */
.stats-row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px}
.stat{background:var(--bg2);border-radius:var(--radius-sm);padding:10px 12px;text-align:center;border:1px solid var(--border)}
.stat-n{font-size:22px;font-weight:600;line-height:1;font-family:var(--mono)}
.stat-l{font-size:10px;color:var(--text2);margin-top:3px;font-weight:400}

/* ── ENTRIES ── */
.entry{border-left:3px solid var(--green);padding:10px 12px;background:var(--bg2);border-radius:0 var(--radius-sm) var(--radius-sm) 0;margin-bottom:8px;transition:box-shadow .12s}
.entry:hover{box-shadow:var(--shadow)}
.entry.warn{border-left-color:var(--coral)}
.entry-date{font-size:11px;font-weight:600;color:var(--green-d);margin-bottom:5px;font-family:var(--mono)}
.entry.warn .entry-date{color:var(--coral-d)}
.entry-text{font-size:12px;line-height:1.7;white-space:pre-wrap;color:var(--text)}
.entry-actions{display:flex;gap:6px;margin-top:8px}

/* ── TAGS ── */
.tag{display:inline-block;font-size:10px;padding:2px 8px;border-radius:20px;font-weight:500;margin:2px 3px 2px 0;cursor:default}
.tag-green{background:var(--green-l);color:var(--green-d)}
.tag-amber{background:var(--amber-l);color:var(--amber-d)}
.tag-blue{background:var(--blue-l);color:var(--blue-d)}
.tag-coral{background:var(--coral-l);color:var(--coral-d)}
.tag-gray{background:var(--gray-l);color:var(--gray)}
.dot{width:7px;height:7px;border-radius:50%;display:inline-block;flex-shrink:0}

/* ── ATELIERS ── */
.atelier-hdr{display:grid;grid-template-columns:1fr 26px 26px;gap:6px;padding:0 4px 4px;border-bottom:1px solid var(--border);margin-bottom:2px}
.atelier-row{display:grid;grid-template-columns:1fr 26px 26px;gap:6px;align-items:center;padding:5px 4px;border-bottom:1px solid var(--border);font-size:12px}
.atelier-row:last-child{border:none}
input[type=checkbox]{width:15px;height:15px;accent-color:var(--green);cursor:pointer;justify-self:center}

/* ── STARS ── */
.stars{display:flex;gap:3px}
.star{width:13px;height:13px;border-radius:3px;background:var(--bg2);border:1px solid var(--border);cursor:pointer;transition:all .1s;flex-shrink:0}
.star.on{background:var(--amber);border-color:var(--amber-d)}

/* ── SKILL ROW ── */
.skill-row{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center;padding:6px 0;border-bottom:1px solid var(--border);font-size:12px}
.skill-row:last-child{border:none}

/* ── BADGE DOT ── */
.warn-badge{display:inline-block;width:7px;height:7px;background:var(--amber);border-radius:50%;margin-left:4px;vertical-align:middle}

/* ── DROP ZONE ── */
.drop-zone{border:2px dashed var(--border);border-radius:var(--radius);padding:22px;text-align:center;cursor:pointer;transition:all .2s;background:var(--bg2)}
.drop-zone:hover,.drop-zone.over{border-color:var(--green);background:var(--green-l)}
.drop-zone-icon{font-size:28px;margin-bottom:8px}

/* ── PROGRESS ── */
.prog-wrap{height:4px;background:var(--bg2);border-radius:2px;overflow:hidden;margin-top:6px}
.prog-fill{height:100%;background:var(--green);border-radius:2px;transition:width .4s}

/* ── MODAL OVERLAY ── */
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:100;align-items:center;justify-content:center}
.overlay.open{display:flex}
.modal{background:var(--white);border-radius:var(--radius);padding:20px;width:420px;max-width:calc(100vw - 32px);box-shadow:0 8px 32px rgba(0,0,0,.18);max-height:90vh;overflow-y:auto}
.modal-title{font-size:14px;font-weight:600;margin-bottom:14px}

/* ── EMPTY ── */
.empty{text-align:center;padding:4rem 2rem;color:var(--text2)}
.empty-icon{font-size:40px;margin-bottom:12px}
.empty-title{font-size:14px;font-weight:500;color:var(--text);margin-bottom:6px}

/* ── ALERT ── */
.alert-info{background:var(--blue-l);border:1px solid var(--blue);color:var(--blue-d);border-radius:var(--radius-sm);padding:10px 12px;font-size:12px;margin-bottom:10px;line-height:1.6}
.alert-warn{background:var(--amber-l);border:1px solid var(--amber);color:var(--amber-d);border-radius:var(--radius-sm);padding:10px 12px;font-size:12px;margin-bottom:10px}
.alert-success{background:var(--green-l);border:1px solid var(--green);color:var(--green-d);border-radius:var(--radius-sm);padding:10px 12px;font-size:12px;margin-bottom:10px}

/* ── GRID ── */
.g2{display:grid;grid-template-columns:1fr 1fr;gap:10px}

/* ── HEADER PANEL ── */
.panel-header{display:flex;align-items:center;gap:12px;margin-bottom:14px;padding-bottom:14px;border-bottom:1px solid var(--border)}
.panel-avatar{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:700;flex-shrink:0}

/* ── INSTALL BANNER ── */
.install-banner{background:var(--green-l);border:1px solid var(--green);color:var(--green-d);padding:8px 14px;font-size:12px;display:flex;align-items:center;gap:10px;flex-shrink:0}
.install-banner b{font-weight:600}

/* scrollbars */
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}

/* ── IMPORT SECTION ── */
#import-section{display:none;padding:12px;border-bottom:1px solid var(--border);background:var(--bg2)}

@media(max-width:600px){
  .sidebar{display:none}
  .topbar-sub{display:none}
}
</style>
</head>
<body>

<div class="install-banner" id="install-banner" style="display:none">
  <span>🍳</span>
  <span><b>Installer l'appli</b> — Clique sur le bouton ci-dessous pour l'ajouter à ton bureau</span>
  <button class="btn-sm btn-green" onclick="installApp()" style="margin-left:auto;white-space:nowrap">Installer</button>
  <button class="btn-sm" onclick="document.getElementById('install-banner').style.display='none'" style="padding:4px 6px">×</button>
</div>

<div class="topbar">
  <div class="topbar-logo">🍳</div>
  <div>
    <div class="topbar-title">Suivi Cuisine — MNA</div>
  </div>
  <div class="topbar-sub" id="topbar-count">0 jeunes</div>
  <div class="topbar-actions">
    <button class="btn-sm btn-blue" onclick="toggleImport()">📄 Importer .docx</button>
    <button class="btn-sm btn-green" onclick="openNewJeune()">+ Nouveau</button>
    <button class="btn-sm" onclick="exportCurrentPDF()" id="btn-export" style="display:none">⬇ PDF</button>
    <button class="btn-sm" onclick="resetData()" style="color:var(--coral-d);border-color:var(--coral)" title="Réinitialiser toutes les données">↺ Reset</button>
  </div>
</div>

<div id="import-section">
  <div class="alert-info">Glisse le fichier .docx du carnet de bord d'un jeune ici. Les dates et annotations sont détectées automatiquement.</div>
  <div class="drop-zone" id="drop-zone"
    onclick="document.getElementById('file-input').click()"
    ondragover="event.preventDefault();this.classList.add('over')"
    ondragleave="this.classList.remove('over')"
    ondrop="handleDrop(event)">
    <div class="drop-zone-icon">📂</div>
    <div style="font-size:13px;font-weight:500;margin-bottom:4px">Clique ou glisse un fichier .docx</div>
    <div style="font-size:11px;color:var(--text2)">Carnet de bord d'un jeune</div>
  </div>
  <input type="file" id="file-input" accept=".docx" style="display:none" onchange="handleFile(this.files[0])">
  <div id="import-status" style="display:none;margin-top:10px">
    <div style="font-size:12px;color:var(--text2)" id="import-status-text">Lecture…</div>
    <div class="prog-wrap"><div class="prog-fill" id="import-progress-fill" style="width:0%"></div></div>
  </div>
  <div id="import-preview" style="display:none;margin-top:10px"></div>
</div>

<div class="layout">
  <div class="sidebar">
    <div class="sidebar-top">
      <div class="search-wrap">
        <span class="search-icon">⌕</span>
        <input type="search" placeholder="Rechercher…" id="search-input" oninput="renderSidebar()">
      </div>
    </div>
    <div class="sidebar-list" id="sidebar-list"></div>
  </div>

  <div class="main" id="main-panel">
    <div id="empty-state">

      <!-- HERO -->
      <div style="text-align:center;padding:28px 16px 20px;border-bottom:1px solid var(--border);margin-bottom:20px">
        <div style="width:56px;height:56px;background:var(--green);border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:28px;margin:0 auto 12px">🍳</div>
        <div style="font-size:20px;font-weight:600;margin-bottom:4px">Suivi Cuisine — MNA</div>
        <div style="font-size:12px;color:var(--text2)">Formateur Yvan · EVAM</div>
      </div>

      <!-- IMPORT ZONE -->
      <div style="max-width:480px;margin:0 auto;padding:0 8px">
        <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--text2);margin-bottom:10px">Importer un carnet de bord</div>
        <div id="home-drop-zone"
          style="border:2px dashed var(--border);border-radius:12px;padding:28px 20px;text-align:center;cursor:pointer;background:var(--bg2);transition:all .2s"
          onclick="document.getElementById('home-file-input').click()"
          ondragover="event.preventDefault();this.style.borderColor='var(--green)';this.style.background='var(--green-l)'"
          ondragleave="this.style.borderColor='var(--border)';this.style.background='var(--bg2)'"
          ondrop="homeDrop(event)">
          <div style="font-size:32px;margin-bottom:10px">📂</div>
          <div style="font-size:14px;font-weight:500;margin-bottom:4px;color:var(--text)">Glisse ton fichier .docx ici</div>
          <div style="font-size:12px;color:var(--text2);margin-bottom:14px">ou clique pour choisir un fichier</div>
          <button class="btn-green btn-sm" onclick="event.stopPropagation();document.getElementById('home-file-input').click()">Choisir un fichier .docx</button>
        </div>
        <input type="file" id="home-file-input" accept=".docx" style="display:none" onchange="handleFile(this.files[0])">

        <div id="home-import-status" style="display:none;margin-top:10px"></div>
        <div id="home-import-preview" style="display:none;margin-top:10px"></div>

        <!-- OU CRÉER -->
        <div style="display:flex;align-items:center;gap:10px;margin:16px 0">
          <div style="flex:1;height:1px;background:var(--border)"></div>
          <div style="font-size:11px;color:var(--text2)">ou</div>
          <div style="flex:1;height:1px;background:var(--border)"></div>
        </div>
        <button onclick="openNewJeune()" style="width:100%;padding:10px;border:1px solid var(--border);border-radius:var(--radius);background:var(--white);font-size:13px;cursor:pointer;color:var(--text)">
          ➕ Créer un nouveau profil manuellement
        </button>

        <!-- JEUNES EXISTANTS -->
        <div style="margin-top:20px">
          <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--text2);margin-bottom:8px">Profils existants</div>
          <div id="home-jeunes-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:8px"></div>
        </div>
      </div>

    </div>
    <div id="jeune-panel" style="display:none"></div>
  </div>
</div>

<!-- MODAL NOUVEAU JEUNE -->
<div class="overlay" id="modal-new-jeune">
  <div class="modal">
    <div class="modal-title">Nouveau jeune</div>
    <div class="g2" style="margin-bottom:10px">
      <div><label style="font-size:11px;color:var(--text2);display:block;margin-bottom:3px">Prénom *</label><input type="text" id="nj-prenom" placeholder="Prénom"></div>
      <div><label style="font-size:11px;color:var(--text2);display:block;margin-bottom:3px">Nom complet</label><input type="text" id="nj-nom" placeholder="Nom"></div>
      <div><label style="font-size:11px;color:var(--text2);display:block;margin-bottom:3px">Date de naissance</label><input type="date" id="nj-ddn"></div>
      <div><label style="font-size:11px;color:var(--text2);display:block;margin-bottom:3px">Date d'arrivée</label><input type="date" id="nj-arrivee"></div>
      <div><label style="font-size:11px;color:var(--text2);display:block;margin-bottom:3px">Référente</label><input type="text" id="nj-ref" placeholder="Référente"></div>
      <div><label style="font-size:11px;color:var(--text2);display:block;margin-bottom:3px">N° dossier</label><input type="text" id="nj-dossier" placeholder="CSS / N°"></div>
    </div>
    <div style="display:flex;gap:8px">
      <button class="btn-green" onclick="addJeune()">Créer le profil</button>
      <button onclick="closeModal('modal-new-jeune')">Annuler</button>
    </div>
  </div>
</div>

<script>
const CUISINE_D=['Initiation cuisine','Techniques de base','Hygiène & sécurité','Repas collectifs','Recettes du monde'];
const AUTO_D=['Préparation autonome','Menus équilibrés','Courses & budget','Gestion des repas','Conservation / hygiène'];
const SKILLS_D=['Couper / éplucher','Cuisson à la poêle','Cuisson au four','Assaisonnement','Présentation du plat','Gérer son poste','Respecter les temps','Lire une recette','Nettoyage / rangement','Travail propre & ordonné'];
const ADMIN_C=['Dossier M-Files','Convention signée','Objectifs fixés','Finalisation PERI','Projet de vie'];
const COMPORT_C=['Ponctualité','Implication','Travail en équipe','Autonomie générale','Communication'];
const PALETTE=['#1D9E75','#185FA5','#BA7517','#D85A30','#534AB7','#993556','#3B6D11','#993C1D','#0891B2','#7C3AED'];

let DB={}, currentJeune=null, tempTags=[], editingIdx=null;
let deferredPrompt=null;

// PWA install
window.addEventListener('beforeinstallprompt', e=>{
  e.preventDefault(); deferredPrompt=e;
  document.getElementById('install-banner').style.display='flex';
});
function installApp(){
  if(deferredPrompt){deferredPrompt.prompt();deferredPrompt.userChoice.then(()=>{deferredPrompt=null;document.getElementById('install-banner').style.display='none';});}
}

// Manifest inline
const manifest={name:'Suivi Cuisine MNA',short_name:'Cuisine MNA',start_url:'.',display:'standalone',background_color:'#FAFAF8',theme_color:'#1D9E75',icons:[{src:'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><text y=".9em" font-size="90">🍳</text></svg>',sizes:'any',type:'image/svg+xml'}]};
const blob=new Blob([JSON.stringify(manifest)],{type:'application/json'});
document.getElementById('manifest-link').href=URL.createObjectURL(blob);

function loadDB(){
  // Charge directement les données — pas de localStorage
  loadDefaults();
}


function resetData(){
  if(!confirm('Réinitialiser toutes les données ?\n\nCela recharge les profils de départ (Abdi Kaadir, Manal, Abdalla, Qaher).\nVos autres profils seront supprimés.'))return;
  DB={};currentJeune=null;
  loadDefaults();
  document.getElementById('jeune-panel').style.display='none';
  document.getElementById('empty-state').style.display='block';
  document.getElementById('btn-export').style.display='none';
  renderSidebar();
  alert('Données réinitialisées — Abdi Kaadir, Manal, Abdalla et Qaher rechargés.');
}
function saveDB(){/* données en mémoire uniquement */}

function makeProfile(prenom,nom,ddn,arrivee,ref,dossier){
  return{prenom,nom,ddn,arrivee,ref,dossier,
    ateliers:{cuisine:CUISINE_D.map(n=>({name:n,fait:false,valide:false})),auto:AUTO_D.map(n=>({name:n,fait:false,valide:false}))},
    skills:SKILLS_D.map(n=>({name:n,level:0})),
    adminChecks:ADMIN_C.map(n=>({name:n,done:false})),
    comportChecks:COMPORT_C.map(n=>({name:n,level:0,note:''})),
    entries:[],obs_generale:'',evo_positives:[],pts_consolider:[],synthese:'',pays:'',langue:'Somali',coref:'',formateur:'Yvan'};
}

