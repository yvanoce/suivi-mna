function parseCarnet(text,filename){
  const MONTHS={janvier:1,janv:1,fev:2,févr:2,février:2,fevrier:2,mars:3,avr:4,avril:4,mai:5,juin:6,juil:7,juillet:7,aout:8,août:8,sep:9,sept:9,septembre:9,oct:10,octobre:10,nov:11,novembre:11,dec:12,déc:12,décembre:12,decembre:12};
  const CY=new Date().getFullYear();
  const lines=text.split('\n').map(l=>l.trim()).filter(Boolean);

  // ── 1. IDENTITY from first lines ──
  let prenom=filename.replace(/^\d+_/,'').replace(/_\d.*$/,'').trim();
  let nom='',ddn='',arrivee='',ref='',dossier='',pays='',langue='';

  const headerBlock=lines.slice(0,6).join(' ');

  // Dossier N° — ex: N 882833 or N882833
  const mN=headerBlock.match(/\bN\s*(\d{6,})/);if(mN)dossier='N '+mN[1];
  // CSS
  const mCSS=headerBlock.match(/CSS\s*(\d{6,})/i);if(mCSS)dossier=(dossier?dossier+' · ':'')+mCSS[0];
  // DDN — ex: 17.03.2009
  const mDDN=headerBlock.match(/(\d{1,2})[.\-](\d{1,2})[.\-](\d{4})/);
  if(mDDN)ddn=`${mDDN[3]}-${mDDN[2].padStart(2,'0')}-${mDDN[1].padStart(2,'0')}`;
  // Pays
  const mPays=headerBlock.match(/\|\s*([A-ZÀÂÄÉÈÊËÎÏÔÙÛÜ]{4,})\s*\|/);if(mPays)pays=mPays[1];
  // Référent(e)
  const mRef=text.match(/(?:r[ée]f[eé]rente?|co.r[ée]f[eé]rent)\s+(?:sera\s+)?(?:Me\s+|M\.\s+)?([A-ZÀÂÄ][a-zàâäéèêëîï]+(?:\s+[A-ZÀÂÄa-zàâäéèêëîï]+)?)/i);
  if(mRef)ref=mRef[1];
  // Arrivée — "Arrivée le 4 décembre 2025" or "Arrivée le 4.12.25"
  const mArr1=text.match(/[Aa]rriv[ée]e?\s+le\s+(\d{1,2})\s+(janvier|f[eé]vrier|mars|avril|mai|juin|juillet|ao[uû]t|septembre|octobre|novembre|d[eé]cembre)\s*(\d{4}|\d{2})?/i);
  if(mArr1){
    const mo=MONTHS[mArr1[2].toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'')];
    let y=mArr1[3]?parseInt(mArr1[3]):CY;if(y<100)y+=2000;
    if(mo)arrivee=`${y}-${String(mo).padStart(2,'0')}-${mArr1[1].padStart(2,'0')}`;
  }
  if(!arrivee){
    const mArr2=text.match(/[Aa]rriv[ée]e?\s+le\s+(\d{1,2})[.\-\/](\d{1,2})[.\-\/]?(\d{2,4})?/);
    if(mArr2){let y=mArr2[3]?parseInt(mArr2[3]):CY;if(y<100)y+=2000;arrivee=`${y}-${mArr2[2].padStart(2,'0')}-${mArr2[1].padStart(2,'0')}`;}
  }

  // ── 2. DATE DETECTION — handles all formats Yvan uses ──
  function parseDate(line){
    const l=line.trim();
    let m;
    // "Le 11" or "Le 11 decembre" or "Le 26 01" — "Le" prefix
    m=l.match(/^[Ll]e\s+(\d{1,2})\s+(janvier|f[eé]vrier|mars|avril|mai|juin|juillet|ao[uû]t|septembre|octobre|novembre|d[eé]cembre)\s*(\d{4}|\d{2})?$/i);
    if(m){const mo=MONTHS[m[2].toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'')];let y=m[3]?parseInt(m[3]):CY;if(y<100)y+=2000;if(mo)return `${y}-${String(mo).padStart(2,'0')}-${m[1].padStart(2,'0')}`;}
    // "Le 26 01" = day month as numbers
    m=l.match(/^[Ll]e\s+(\d{1,2})\s+(\d{1,2})\.?\.?$/);
    if(m)return `${CY}-${m[2].padStart(2,'0')}-${m[1].padStart(2,'0')}`;
    // "Le 11" alone = day only, use arrivee month or current
    m=l.match(/^[Ll]e\s+(\d{1,2})\.?$/);
    if(m){
      const refDate=arrivee?new Date(arrivee):new Date();
      return `${refDate.getFullYear()}-${String(refDate.getMonth()+1).padStart(2,'0')}-${m[1].padStart(2,'0')}`;
    }
    // "17.03" or "17.03.2025" or "15.4"
    m=l.match(/^(\d{1,2})[.\-\/](\d{1,2})[.\-\/](\d{2,4})[\s.]*$/);
    if(m){let y=parseInt(m[3]);if(y<100)y+=2000;return `${y}-${m[2].padStart(2,'0')}-${m[1].padStart(2,'0')}`;}
    m=l.match(/^(\d{1,2})[.\-\/](\d{1,2})[\s.]*$/);
    if(m)return `${CY}-${m[2].padStart(2,'0')}-${m[1].padStart(2,'0')}`;
    // "17 mars" or "17 mars 2025"
    m=l.match(/^(\d{1,2})\s+(janvier|f[eé]vrier|mars|avril|mai|juin|juillet|ao[uû]t|septembre|octobre|novembre|d[eé]cembre)\s*(\d{4}|\d{2})?[\s.]*$/i);
    if(m){const mo=MONTHS[m[2].toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'')];let y=m[3]?parseInt(m[3]):CY;if(y<100)y+=2000;if(mo)return `${y}-${String(mo).padStart(2,'0')}-${m[1].padStart(2,'0')}`;}
    // Date anywhere in the line (not just start) — fallback for loose dates
    m=l.match(/(\d{1,2})[.\-](\d{1,2})[.\-](\d{4})/);
    if(m&&l.length<20)return `${m[3]}-${m[2].padStart(2,'0')}-${m[1].padStart(2,'0')}`;
    return null;
  }

  // ── 3. SPLIT INTO ENTRIES ──
  const entries=[];
  let curDate=null,curLines=[];
  // Skip header lines (identity block = first lines containing MNA/N°/CSS)
  const bodyLines=lines.slice(0,5).some(l=>/MNA|N\s*\d{6}|CSS/i.test(l))?lines.slice(3):lines;

  function flush(){
    if(curDate&&curLines.length){
      const t=curLines.join('\n').trim();
      if(t.length>4&&!/^\|/.test(t))
        entries.push({date:curDate,tags:autoTags(t),text:t});
    }
    curLines=[];
  }

  // Inline date patterns — date starts the line but text follows on same line
  // e.g. "Le 11 je discute…" or "17.03 anniversaire…" or "15.4 il a cuisiné…"
  function extractInlineDate(l){
    let m,rest;
    // "Le 11 texte..." (day only inline)
    m=l.match(/^[Ll]e\s+(\d{1,2})\s+(.+)$/);
    if(m&&!/^(janvier|février|mars|avril|mai|juin|juillet|août|septembre|octobre|novembre|décembre|\d{2})/i.test(m[2])){
      const refDate=arrivee?new Date(arrivee):new Date();
      return {date:`${refDate.getFullYear()}-${String(refDate.getMonth()+1).padStart(2,'0')}-${m[1].padStart(2,'0')}`,rest:m[2]};
    }
    // "Le 26 01 texte..." or "Le 11 janvier texte..."
    m=l.match(/^[Ll]e\s+(\d{1,2})\s+(\d{1,2})\.?\s+(.+)$/);
    if(m)return {date:`${CY}-${m[2].padStart(2,'0')}-${m[1].padStart(2,'0')}`,rest:m[3]};
    m=l.match(/^[Ll]e\s+(\d{1,2})\s+(janvier|f[eé]vrier|mars|avril|mai|juin|juillet|ao[uû]t|septembre|octobre|novembre|d[eé]cembre)\s*(\d{4})?\s+(.+)$/i);
    if(m){const mo=MONTHS[m[2].toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'')];if(mo){let y=m[3]?parseInt(m[3]):CY;return {date:`${y}-${String(mo).padStart(2,'0')}-${m[1].padStart(2,'0')}`,rest:m[4]};}}
    // "17.03 texte..." or "15.4 texte..."
    m=l.match(/^(\d{1,2})[.\-\/](\d{1,2})[.\-\/]?(\d{2,4})?\s+(.+)$/);
    if(m&&m[4]){let y=m[3]?parseInt(m[3]):CY;if(y<100)y+=2000;return {date:`${y}-${m[2].padStart(2,'0')}-${m[1].padStart(2,'0')}`,rest:m[4]};}
    return null;
  }

  bodyLines.forEach(l=>{
    if(/^\|/.test(l)||!l)return;
    // Skip arrivée line (already extracted)
    if(/[Aa]rriv[ée]e?\s+le/i.test(l))return;
    // Try pure date line first
    const d=parseDate(l);
    if(d){flush();curDate=d;return;}
    // Try inline date+text
    const inl=extractInlineDate(l);
    if(inl){flush();curDate=inl.date;if(inl.rest.trim().length>2)curLines.push(inl.rest.trim());return;}
    // Plain text
    if(curDate&&l.length>2)curLines.push(l);
    else if(!curDate&&l.length>10){
      curDate=arrivee||new Date().toISOString().slice(0,10);
      curLines.push(l);
    }
  });
  flush();

  return{prenom,nom,ddn,arrivee,ref,dossier,pays,entries};
}

function autoTags(t){
  const tags=[];
  if(/(cuisiné|cuisine|cuisson|recette|repas|riz|pâtes|pates|soupe|gâteau|gateau|beignet|malawa|pizza|poulet|oignon|frite|tomate|hamburger|mayonnaise|curry|épices|épice)/i.test(t))tags.push('Cuisine');
  if(/(courses|budget|marché|calculette|argent)/i.test(t))tags.push('Courses');
  if(/(vigilance|déprim|triste|pleur|fond du lit|surveill|mal|fatigué)/i.test(t))tags.push('Vigilance');
  if(/(absent|pas venu|ne vient pas|poirott|n'est pas)/i.test(t))tags.push('Absent');
  if(/(ponctualité|retard|attente|attend|oublié)/i.test(t))tags.push('Ponctualité');
  if(/(collectif|groupe|ensemble|invité|amis|potes|tablée|convivial)/i.test(t))tags.push('Collectif');
  if(/(bravo|super|excellent|parfait|progrès|progress|fulgur|bien|bon sens|souriant|positif|évolué|perspicace)/i.test(t))tags.push('Progression');
  if(/(pâtisserie|gaufre|crème|crêpe|cake|gateau|gâteau|pain|mayonnaise)/i.test(t))tags.push('Pâtisserie');
  if(/(anniversaire|anniv|fête)/i.test(t))tags.push('Anniversaire');
  if(/(ramadan)/i.test(t))tags.push('Ramadan');
  if(/(rangement|nettoyage|frigo|cuisine propre|tri)/i.test(t))tags.push('Rangement');
  return tags.length?tags:['Note'];
}

// ── SMART DETECT: analyse tout le texte du carnet pour pré-remplir ateliers & compétences ──
function detectAteliersFromText(fullText){
  const T=fullText.toLowerCase();
  const cuisine=[];
  const auto=[];
  const skills=[];

  // ── ATELIERS CUISINE ──
  const cuisineRules=[
    {name:'Initiation cuisine',     re:/(initiation|débuter|premier.*repas|premièr.*fois|1er.*fois|1ere.*fois|découvert la cuisine|ne savait pas cuisiner)/i},
    {name:'Techniques de base',     re:/(désoss|pané|maïzena|maizena|couper|éplucher|eplucher|tailler|trancher|rouler|pétrir)/i},
    {name:'Hygiène & sécurité',     re:/(hygiène|hygiene|sécurité|securite|propre|nettoy|rangement|dangereux|danger|règle.*cuisine|couteau|brûl)/i},
    {name:'Repas collectifs',       re:/(repas.*collectif|repas.*group|tablée|cuisin.*ensemble|cuisin.*pour.*tous|cuisin.*pour.*group|assemblée|souper.*équipe)/i},
    {name:'Recettes du monde',      re:/(kebab|kabuli|cevab|somalien|afghan|agneau|malawa|curry|épices.*tradition|recette.*origin)/i},
    {name:'Pâtisserie & desserts',  re:/(gâteau|gateau|pain.*hamburger|hamburger|mayonnaise|crème|crêpe|gaufre|beignet|cake|pâtisserie)/i},
  ];
  cuisineRules.forEach(r=>{if(r.re.test(T))cuisine.push({name:r.name,fait:true,valide:false});});

  // ── ATELIERS AUTONOMIE ──
  const autoRules=[
    {name:'Préparation autonome',   re:/(prépar.*seul|cuisin.*seul|tout seul|autonome|fait.*lui.même|il a fait|a prépar|a cuisiné)/i},
    {name:'Menus équilibrés',       re:/(équilibr|légumes|nutrition|nutri|verdure|salade|menu|variété|varié)/i},
    {name:'Courses & budget',       re:/(courses|marché|budget|calculette|argent|prix|liste.*course|faire les courses)/i},
    {name:'Gestion des repas',      re:/(gestion|planif|organisation|liste|vide frigo|restes|utiliser.*restes|frigo)/i},
    {name:'Conservation / hygiène', re:/(frigo|conservation|conserver|propre|nettoy|rangement|tri.*épices)/i},
  ];
  autoRules.forEach(r=>{if(r.re.test(T))auto.push({name:r.name,fait:true,valide:false});});

  // ── COMPÉTENCES ──
  const skillRules=[
    {name:'Couper / éplucher',              re:/(coup|éplucher|eplucher|tailler|trancher|désoss|desoss)/i,             level:2},
    {name:'Cuisson à la poêle',             re:/(poêle|poele|fri(t|re)|sauter|revenir|dorer)/i,                       level:2},
    {name:'Cuisson au four',                re:/(four|rôti|roti|gratin|agneau.*four|poulet.*four)/i,                   level:2},
    {name:'Assaisonnement',                 re:/(assaisonn|épic|épice|sel|poivre|herbe|sauce|curry)/i,                 level:2},
    {name:'Présentation du plat',           re:/(présent|dressage|belle|bien fait|soigné|joli)/i,                      level:1},
    {name:'Gérer son poste de travail',     re:/(rangement|place|organisé|poste|mise en place|chaque chose)/i,         level:2},
    {name:'Respecter les temps de cuisson', re:/(temps.*cuisson|cuisson.*parfait|bien cuit|respect.*temps)/i,          level:1},
    {name:'Lire & suivre une recette',      re:/(recette|livre.*cuisine|suivre|lire|hamburger.*végétar)/i,             level:1},
    {name:'Nettoyage / rangement',          re:/(nettoy|rangement|propre|vaisselle|frigo.*nettoy|cuisine.*propre)/i,   level:2},
    {name:'Travail propre & ordonné',       re:/(ordonné|propre|bien|soin|précis|bonne.*façon|de la meilleure)/i,      level:2},
  ];
  skillRules.forEach(r=>{
    if(r.re.test(T))skills.push({name:r.name,level:r.level});
    else skills.push({name:r.name,level:0});
  });

  return{cuisine,auto,skills};
}

function showPreview(parsed){
  const detected=detectAteliersFromText(parsed.entries.map(e=>e.text).join(' '));
  parsed._detected=detected;
  const prev=document.getElementById('home-import-preview')||document.getElementById('import-preview');
  prev.style.display='block';
  const exists=DB.hasOwnProperty(parsed.prenom);
  const atelierCount=detected.cuisine.length+detected.auto.length;
  const skillCount=detected.skills.filter(s=>s.level>0).length;
  prev.innerHTML=`<div class="${exists?'alert-warn':'alert-success'}">
