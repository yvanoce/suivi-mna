    </div>`:''}
  </div>
  <div style="display:flex;gap:8px">
    <button class="btn-green btn-sm" onclick='doImport(${JSON.stringify(parsed).replace(/'/g,"&#39;")})'>Importer</button>
    <button class="btn-sm" onclick="document.getElementById('import-preview').style.display='none'">Annuler</button>
  </div>`;
}

function doImport(parsed){
  const detected=parsed._detected||detectAteliersFromText(parsed.entries.map(e=>e.text).join(' '));
  if(!DB[parsed.prenom]){
    DB[parsed.prenom]=makeProfile(parsed.prenom,parsed.nom,parsed.ddn,parsed.arrivee,parsed.ref,parsed.dossier);
  } else {
    if(parsed.arrivee&&!DB[parsed.prenom].arrivee)DB[parsed.prenom].arrivee=parsed.arrivee;
    if(parsed.ref&&!DB[parsed.prenom].ref)DB[parsed.prenom].ref=parsed.ref;
  }
  // Merge entries (no duplicates)
  parsed.entries.forEach(e=>{
    if(!DB[parsed.prenom].entries.some(x=>x.date===e.date&&x.text===e.text))
      DB[parsed.prenom].entries.push(e);
  });
  // Pre-fill ateliers cuisine — only add if not already present
  detected.cuisine.forEach(a=>{
    const exists=DB[parsed.prenom].ateliers.cuisine.find(x=>x.name===a.name);
    if(exists){exists.fait=true;}
    else DB[parsed.prenom].ateliers.cuisine.push(a);
  });
  // Pre-fill ateliers auto — only add if not already present
  detected.auto.forEach(a=>{
    const exists=DB[parsed.prenom].ateliers.auto.find(x=>x.name===a.name);
    if(exists){exists.fait=true;}
    else DB[parsed.prenom].ateliers.auto.push(a);
  });
  // Pre-fill skills — update level only if detected level > current
  detected.skills.forEach(s=>{
    const existing=DB[parsed.prenom].skills.find(x=>x.name===s.name);
    if(existing){if(s.level>existing.level)existing.level=s.level;}
    else if(s.level>0) DB[parsed.prenom].skills.push(s);
  });
  saveDB();renderSidebar();selectJeune(parsed.prenom);
  document.getElementById('import-section').style.display='none';
  document.getElementById('import-preview').style.display='none';
  renderHomeGrid();
}

