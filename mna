/* ── CARNET ── */
function renderCarnetHTML(){
  const today=new Date().toISOString().slice(0,10);
  const entries=[...DB[currentJeune].entries].map((e,i)=>({...e,_i:i})).sort((a,b)=>b.date.localeCompare(a.date));
  const entriesHtml=entries.length?entries.map(e=>{
    const warn=(e.tags||[]).some(t=>/(vigilance|déprim|surveill|absent)/i.test(t));
    const tagsHtml=(e.tags||[]).map(t=>{
      const cls=/(vigilance|déprim|surveill|absent)/i.test(t)?'tag-coral':/(cuisine|atelier|pâtiss)/i.test(t)?'tag-green':/(ponctualité|retard)/i.test(t)?'tag-amber':'tag-gray';
      return `<span class="tag ${cls}">${t}</span>`;
    }).join('');
    return `<div class="entry${warn?' warn':''}">
      <div class="entry-date">${fmtDate(e.date)}</div>
      <div style="margin-bottom:6px">${tagsHtml}</div>
      <div class="entry-text">${escHtml(e.text)}</div>
      <div class="entry-actions">
        <button class="btn-sm" onclick="editEntry(${e._i})">Modifier</button>
        <button class="btn-sm btn-danger" onclick="deleteEntry(${e._i})">Supprimer</button>
      </div></div>`;
  }).join(''):'<div style="text-align:center;padding:2rem;color:var(--text2);font-size:12px">Aucune annotation</div>';
  return `<div class="card">
    <div class="card-title"><span class="dot" style="background:var(--blue)"></span>Nouvelle annotation</div>
    <div style="display:flex;gap:8px;margin-bottom:8px">
      <input type="date" id="entry-date" value="${today}" style="max-width:150px">
      <div style="flex:1;display:flex;flex-wrap:wrap;gap:4px;align-items:center" id="tag-pills"></div>
    </div>
    <div style="display:flex;gap:6px;margin-bottom:8px">
      <input type="text" id="new-tag" placeholder="Tag (ex: Cuisine, Vigilance…)" onkeydown="if(event.key==='Enter'){addTag();event.preventDefault()}">
      <button class="btn-sm" onclick="addTag()">+ tag</button>
    </div>
    <textarea id="entry-text" placeholder="Écris ton annotation ici…"></textarea>
    <div style="display:flex;gap:8px;margin-top:8px">
      <button class="btn-green btn-sm" onclick="saveEntry()">Enregistrer</button>
      <button class="btn-sm" onclick="clearForm()">Effacer</button>
    </div>
  </div>
  <div id="entries-container">${entriesHtml}</div>`;
}

function bindCarnet(){
  tempTags=[];editingIdx=null;renderTagPills();
}
function addTag(){
  const inp=document.getElementById('new-tag');
  const t=inp.value.trim();if(!t||tempTags.includes(t))return;
  tempTags.push(t);inp.value='';renderTagPills();
}
function renderTagPills(){
  const w=document.getElementById('tag-pills');if(!w)return;
  w.innerHTML=tempTags.map((t,i)=>`<span class="tag tag-green" style="cursor:pointer" onclick="tempTags.splice(${i},1);renderTagPills()">${escHtml(t)} ×</span>`).join('');
}
function saveEntry(){
  const date=document.getElementById('entry-date').value||new Date().toISOString().slice(0,10);
  const text=document.getElementById('entry-text').value.trim();if(!text)return;
  if(editingIdx!==null){DB[currentJeune].entries.splice(editingIdx,1);editingIdx=null;}
  DB[currentJeune].entries.push({date,tags:[...tempTags],text});
  saveDB();clearForm();
  document.getElementById('entries-container').innerHTML=buildEntriesHTML();
  renderSidebar();
}
function clearForm(){
  document.getElementById('entry-date').value=new Date().toISOString().slice(0,10);
  document.getElementById('entry-text').value='';
  tempTags=[];renderTagPills();editingIdx=null;
}
function editEntry(i){
  const e=DB[currentJeune].entries[i];
  document.getElementById('entry-date').value=e.date;
  document.getElementById('entry-text').value=e.text;
  tempTags=[...(e.tags||[])];renderTagPills();editingIdx=i;
  document.getElementById('entry-date').scrollIntoView({behavior:'smooth'});
}
function deleteEntry(i){
  if(!confirm('Supprimer cette annotation ?'))return;
  DB[currentJeune].entries.splice(i,1);saveDB();
  document.getElementById('entries-container').innerHTML=buildEntriesHTML();
  renderSidebar();
}
function buildEntriesHTML(){
  const entries=[...DB[currentJeune].entries].map((e,i)=>({...e,_i:i})).sort((a,b)=>b.date.localeCompare(a.date));
  if(!entries.length)return '<div style="text-align:center;padding:2rem;color:var(--text2);font-size:12px">Aucune annotation</div>';
  return entries.map(e=>{
    const warn=(e.tags||[]).some(t=>/(vigilance|déprim|surveill|absent)/i.test(t));
    const tagsHtml=(e.tags||[]).map(t=>{
      const cls=/(vigilance|déprim|surveill|absent)/i.test(t)?'tag-coral':/(cuisine|atelier|pâtiss)/i.test(t)?'tag-green':/(ponctualité|retard)/i.test(t)?'tag-amber':'tag-gray';
      return `<span class="tag ${cls}">${t}</span>`;
    }).join('');
    return `<div class="entry${warn?' warn':''}">
      <div class="entry-date">${fmtDate(e.date)}</div>
      <div style="margin-bottom:6px">${tagsHtml}</div>
      <div class="entry-text">${escHtml(e.text)}</div>
      <div class="entry-actions">
        <button class="btn-sm" onclick="editEntry(${e._i})">Modifier</button>
        <button class="btn-sm btn-danger" onclick="deleteEntry(${e._i})">Supprimer</button>
      </div></div>`;
  }).join('');
}

