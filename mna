const avatarColor=n=>PALETTE[Math.abs([...n].reduce((a,c)=>a+c.charCodeAt(0),0))%PALETTE.length];
const initials=n=>n.split(' ').slice(0,2).map(w=>w[0]||'').join('').toUpperCase();

function renderSidebar(){
  const q=(document.getElementById('search-input').value||'').toLowerCase();
  const list=document.getElementById('sidebar-list');
  list.innerHTML='';
  const keys=Object.keys(DB).filter(k=>k.toLowerCase().includes(q));
  document.getElementById('topbar-count').textContent=Object.keys(DB).length+' jeune'+(Object.keys(DB).length>1?'s':'');
  keys.forEach(name=>{
    const j=DB[name];
    const tA=j.ateliers.cuisine.length+j.ateliers.auto.length;
    const dA=j.ateliers.cuisine.filter(x=>x.fait).length+j.ateliers.auto.filter(x=>x.fait).length;
    const pct=tA?Math.round(dA/tA*100):0;
    const warn=j.entries.some(e=>(e.tags||[]).some(t=>/(vigilance|déprim|surveill|absent)/i.test(t)));
    const d=document.createElement('div');
    d.className='jeune-item'+(currentJeune===name?' active':'');
    d.innerHTML=`<div class="avatar" style="background:${avatarColor(name)}22;color:${avatarColor(name)}">${initials(name)}</div>
      <div style="flex:1;min-width:0">
        <div style="display:flex;align-items:center;gap:4px">
          <span class="jeune-name">${name}</span>
          ${warn?'<span style="width:6px;height:6px;background:var(--amber);border-radius:50%;flex-shrink:0"></span>':''}
        </div>
        <div class="jeune-meta">${pct}% · ${j.entries.length} note${j.entries.length!==1?'s':''}</div>
      </div>`;
    d.onclick=()=>selectJeune(name);
    list.appendChild(d);
  });
  if(!keys.length) list.innerHTML='<div style="font-size:11px;color:var(--text2);padding:8px 4px">Aucun résultat</div>';
}

