// ── LECTEUR DOCX NATIF (sans CDN) ──
const mammoth = {
  extractRawText: async function({arrayBuffer}) {
    const bytes = new Uint8Array(arrayBuffer);
    let offset = 0;
    while (offset < bytes.length - 30) {
      if (bytes[offset]===0x50&&bytes[offset+1]===0x4B&&bytes[offset+2]===0x03&&bytes[offset+3]===0x04) {
        const comp = bytes[offset+8]|(bytes[offset+9]<<8);
        const cSize = bytes[offset+18]|(bytes[offset+19]<<8)|(bytes[offset+20]<<16)|(bytes[offset+21]<<24);
        const nLen = bytes[offset+26]|(bytes[offset+27]<<8);
        const eLen = bytes[offset+28]|(bytes[offset+29]<<8);
        const name = String.fromCharCode(...bytes.slice(offset+30,offset+30+nLen));
        const dStart = offset+30+nLen+eLen;
        if (name === 'word/document.xml') {
          const data = bytes.slice(dStart, dStart+cSize);
          let xml;
          if (comp===8) {
            try {
              const ds = new DecompressionStream('deflate-raw');
              const w = ds.writable.getWriter();
              const r = ds.readable.getReader();
              w.write(data); w.close();
              const chunks=[]; 
              while(true){const {done,value}=await r.read();if(done)break;chunks.push(value);}
              const total=chunks.reduce((a,b)=>a+b.length,0);
              const res=new Uint8Array(total); let pos=0;
              for(const ch of chunks){res.set(ch,pos);pos+=ch.length;}
              xml = new TextDecoder('utf-8').decode(res);
            } catch(e) {
              xml = new TextDecoder('utf-8',{fatal:false}).decode(bytes);
            }
          } else { xml = new TextDecoder('utf-8').decode(data); }
          return {value: _xmlToText(xml)};
        }
        offset = dStart+cSize;
      } else { offset++; }
    }
    // Fallback brut
    const raw = new TextDecoder('utf-8',{fatal:false}).decode(bytes);
    return {value: _xmlToText(raw)};
  }
};

function _xmlToText(xml) {
  if(!xml) return '';
  let result='', pos=0;
  while(pos < xml.length) {
    const pS=xml.indexOf('<w:p',pos); if(pS<0)break;
    const pE=xml.indexOf('</w:p>',pS); if(pE<0)break;
    const para=xml.slice(pS,pE); let pt='', tp=0;
    while(tp<para.length){
      const tS=para.indexOf('<w:t',tp); if(tS<0)break;
      const tC=para.indexOf('>',tS); if(tC<0)break;
      const tE=para.indexOf('</w:t>',tC); if(tE<0)break;
      pt+=para.slice(tC+1,tE); tp=tE+6;
    }
    result+=(pt.trim()?pt:'')+'\n'; pos=pE+6;
  }
  return result;
}

